{
  "name": "@mega-ui/react",
  "version": "0.1.0",
  "private": true,
  "description": "Composable React components for company web applications.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./docs/*": "./docs/*",
    "./data-grid": {
      "types": "./dist/data-grid.d.ts",
      "import": "./dist/data-grid.js"
    },
    "./data-grid.css": "./dist/data-grid.css",
    "./text-editor": {
      "types": "./dist/text-editor.d.ts",
      "import": "./dist/text-editor.js"
    },
    "./text-editor.css": "./dist/text-editor.css",
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./charts.css": "./dist/charts.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite --config vite.docs.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json && sass --no-source-map --style=compressed src/styles/index.scss dist/styles.css",
    "build:docs": "vite build --config vite.docs.config.ts && node tests/docs-build.check.mjs",
    "preview": "vite preview --config vite.docs.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint:ux && npm run typecheck && npm run format:check && npm test && npm run build:docs",
    "prepack": "npm run build",
    "test:browser": "playwright test",
    "lint:ux": "node docs/check-ux-writing.mjs src examples"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.104.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "echarts": "^6.1.0",
    "qrcode-generator": "^2.0.4",
    "react-data-grid": "7.0.0-beta.61"
  }
}
