{
  "name": "@mega_ui/react",
  "version": "1.1.0",
  "description": "Composable React components for company web applications.",
  "type": "module",
  "license": "MIT",
  "author": "Codeblack Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codeblack-Inc/mega-ui.git"
  },
  "homepage": "https://github.com/Codeblack-Inc/mega-ui#readme",
  "bugs": {
    "url": "https://github.com/Codeblack-Inc/mega-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "data-grid",
    "charts",
    "rich-text-editor",
    "pdf-viewer",
    "typescript"
  ],
  "files": [
    "dist",
    "docs",
    "!docs/ui-audit-*.md",
    "!docs/roadmap.md",
    "!docs/component-gap-report.md",
    "!docs/check-ux-writing.mjs",
    "!docs/*.pdf",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./docs/*": "./docs/*",
    "./data-grid": {
      "types": "./dist/data-grid.d.ts",
      "import": "./dist/data-grid.js"
    },
    "./data-grid.css": "./dist/data-grid.css",
    "./text-editor": {
      "types": "./dist/text-editor.d.ts",
      "import": "./dist/text-editor.js"
    },
    "./text-editor.css": "./dist/text-editor.css",
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./charts.css": "./dist/charts.css",
    "./pdf-viewer": {
      "types": "./dist/pdf-viewer.d.ts",
      "import": "./dist/pdf-viewer.js"
    },
    "./pdf-viewer.css": "./dist/pdf-viewer.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config vite.docs.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/fix-dts-extensions.mjs && sass --no-source-map --style=compressed src/styles/index.scss dist/styles.css",
    "build:docs": "vite build --config vite.docs.config.ts && node tests/docs-build.check.mjs",
    "preview": "vite preview --config vite.docs.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint:ux && npm run typecheck && npm run format:check && npm test && npm run build:docs",
    "test:browser": "playwright test",
    "lint:ux": "node docs/check-ux-writing.mjs src examples",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "echarts": "^6.1.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-data-grid": "7.0.0-beta.61",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "echarts": "^6.1.0",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.6",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-data-grid": "7.0.0-beta.61",
    "react-dom": "^19.2.8",
    "sass": "^1.104.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-image": {
      "optional": true
    },
    "@tiptap/extension-table": {
      "optional": true
    },
    "@tiptap/markdown": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "react-data-grid": {
      "optional": true
    }
  }
}
